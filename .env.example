# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets, URLs, or tokens.
# ---------------------------------------------------------------------------

# Runtime environment: "development" | "test" | "production"
NODE_ENV="development"

# Public base URL of the app (exposed to the browser).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Centralized logger level: "debug" | "info" | "warn" | "error"
LOG_LEVEL="debug"

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# DATABASE_URL  -> pooled connection (used by the app at runtime)
# DIRECT_URL    -> direct connection (used by Prisma Migrate)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---------------------------------------------------------------------------
# Match/team data source
# PREDICTION_DATA_SOURCE -> "seed" (curated dataset) | "live" (external API)
# When "live", FOOTBALL_DATA_API_KEY must be set.
# ---------------------------------------------------------------------------
PREDICTION_DATA_SOURCE="seed"
FOOTBALL_DATA_API_KEY=""
FOOTBALL_DATA_BASE_URL="https://api.football-data.org/v4"
