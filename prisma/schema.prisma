// Prisma schema for the World Cup 2026 Predictor.
// Conventions (CLAUDE.md › Database Rules): UUID primary keys, indexes on every
// relation, soft delete (deletedAt) where appropriate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Confederation {
  UEFA
  CONMEBOL
  CONCACAF
  CAF
  AFC
  OFC
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum MatchStage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams   Team[]
  matches Match[]
}

model Team {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  code          String        @unique
  confederation Confederation
  flagEmoji     String?

  // Strength snapshot consumed by the prediction engine.
  elo                  Float
  attackStrength       Float
  defenseStrength      Float
  expectedGoalsFor     Float
  expectedGoalsAgainst Float
  form                 Float
  availability         Float @default(1)

  groupId String? @db.Uuid
  group   Group?  @relation(fields: [groupId], references: [id])

  players     Player[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([groupId])
  @@index([confederation])
  @@index([deletedAt])
}

model Player {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  position  PlayerPosition
  available Boolean        @default(true)
  rating    Float?

  teamId String @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([teamId])
  @@index([deletedAt])
}

model Match {
  id            String      @id @default(uuid()) @db.Uuid
  stage         MatchStage
  status        MatchStatus @default(SCHEDULED)
  kickoff       DateTime
  venue         String?
  neutralVenue  Boolean     @default(true)
  homeAdvantage Boolean     @default(false)

  homeScore Int?
  awayScore Int?

  groupId String? @db.Uuid
  group   Group?  @relation(fields: [groupId], references: [id])

  homeTeamId String @db.Uuid
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])

  awayTeamId String @db.Uuid
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  predictions Prediction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([groupId])
  @@index([stage])
  @@index([status])
  @@index([kickoff])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([deletedAt])
}

model Prediction {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  homeWinProbability Float
  drawProbability    Float
  awayWinProbability Float
  expectedHomeGoals  Float
  expectedAwayGoals  Float
  mostLikelyHomeGoals Int
  mostLikelyAwayGoals Int
  confidence          Float

  modelVersion String
  // Full EnsemblePrediction payload (model outputs, top scorelines, explanation).
  detail       Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, modelVersion])
  @@index([matchId])
}
